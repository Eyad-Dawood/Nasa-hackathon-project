# Copy this file to server/.env.local for local development (never commit .env.local)
NODE_ENV=development

# AI Provider: "gemini" (production/live) or "mock" (offline/dev fallback without API key)
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=

# Model identifier (e.g. gemini-3.8-flash)
AI_MODEL=gemini-3.8-flash

# Agentic Flight Director bounds & safety limits
AI_TIMEOUT_MS=45000
AI_TOOL_TIMEOUT_MS=5000
AI_MAX_TOOL_ROUNDS=4
AI_MAX_HISTORY_TURNS=8
AI_MAX_CONCURRENT_REQUESTS=2
AI_RATE_LIMIT_PER_MINUTE=20

# ── CORS (production only) ────────────────────────────────
# Comma-separated list of allowed origins for the /rooms endpoint.
# Leave unset or "*" for development. In production set to your
# Cloudflare Pages domain(s), e.g.:
# ALLOWED_ORIGINS=https://my-game.pages.dev,https://custom-domain.com

