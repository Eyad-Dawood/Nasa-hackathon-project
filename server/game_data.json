{
  "meta": {
    "game": "Space Mission Design Game",
    "audience": "ages 7-14",
    "version": "0.2",
    "departments": {
      "power_thermal": "Power and Thermal Engineer",
      "structure_computing": "Structure and Computing Engineer",
      "communications": "Communications Engineer",
      "science": "Science Engineer"
    }
  },
  "rules": {
    "checks": [
      "1 Space: total Size <= Frame Space (+ Cargo Bay Extensions)",
      "2 Thrust: total Thrust >= total Mass x (Launch Pull - Nose Cone reduction)",
      "3 Fuel: fuel stored >= Distance Rating x highest Fuel Burn among engines",
      "4 Power: Power Made >= Power Used - Power Saved (solar is multiplied by Sunlight %)",
      "5 Night Batteries: if any solar panel is used, Battery Storage >= Night Need",
      "6 Heat: Heat Protection >= Heat Danger",
      "7 Radiation: Radiation Protection (shields + Rugged Computer) >= mission Radiation",
      "8 Brain: Brain Power (+ chips) >= Navigation Brain + sum of instrument Brain Use",
      "9 Data Rate: sum of radio Data Rate (+ Pointer Motors) >= Data Made - Data Reduction",
      "10 Signal Range: best radio Range + boosters >= Signal Need",
      "11 Science: Science Points (+10 for Star Instrument) >= Science Goal",
      "12 Budget: total Cost <= Budget"
    ],
    "notes": [
      "Frames take no Space themselves; every other part uses its Size.",
      "Fuel Burn does not stack.",
      "Each ship needs exactly 1 frame, 1 computer, and at least 1 radio.",
      "Check max_per_ship on each part (null = unlimited)."
    ]
  },
