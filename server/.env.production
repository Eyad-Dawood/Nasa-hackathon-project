NODE_ENV=production

# ── AI Flight Director ─────────────────────────────────────
# Set these in Render Dashboard → Environment Variables (not here)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=<your-key>
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=45000
AI_TOOL_TIMEOUT_MS=5000
AI_MAX_TOOL_ROUNDS=4
AI_MAX_HISTORY_TURNS=8
AI_MAX_CONCURRENT_REQUESTS=2
AI_RATE_LIMIT_PER_MINUTE=20

# ── CORS ───────────────────────────────────────────────────
# Set in Render Dashboard → Environment Variables:
# ALLOWED_ORIGINS=https://your-project.pages.dev
